# ---------------------------------------------------------------------------
# Chronolignee — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST NOT be committed.
# Every variable here is validated at boot by packages/config (Zod). A missing
# or malformed value fails fast at startup rather than at 3am in production.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
# Public origin of the web app. Used for auth callbacks and absolute URLs.
APP_URL=http://localhost:3000
# Comma-separated. Empty in dev means "same origin only".
TRUSTED_ORIGINS=

# --- Database --------------------------------------------------------------
# Port 5434 on the host to avoid colliding with a native PostgreSQL install.
DATABASE_URL=postgresql://chronolignee:chronolignee_dev_only@localhost:5434/chronolignee?schema=public
# Optional: separate pooled URL for serverless deployments.
# DATABASE_POOL_URL=

# --- Redis / job queue -----------------------------------------------------
REDIS_URL=redis://localhost:6380

# --- Authentication --------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MUST be at least 32 bytes of entropy. Never reuse across environments.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Object storage (S3-compatible) ----------------------------------------
# Development defaults target the MinIO service in docker-compose.yml.
# Production: AWS S3, Cloudflare R2, or any S3-compatible provider.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chronolignee-archives
S3_ACCESS_KEY_ID=chronolignee
S3_SECRET_ACCESS_KEY=chronolignee_dev_only
# MinIO needs path-style addressing; most cloud providers do not.
S3_FORCE_PATH_STYLE=true
# Lifetime of presigned download URLs, in seconds.
S3_PRESIGN_TTL_SECONDS=900

# --- AI --------------------------------------------------------------------
# AI never writes canonical genealogy data. It only produces proposals that a
# human must accept (principle 3). See docs/AI.md.
AI_PROVIDER=anthropic
AI_MODEL_PRIMARY=claude-fable-5-1
AI_MODEL_FAST=claude-haiku-4-5-20251001
# Leave empty to run with the deterministic fake provider (CI always does).
ANTHROPIC_API_KEY=
AI_MAX_CONCURRENCY=2
AI_REQUEST_TIMEOUT_MS=120000

# --- Maps ------------------------------------------------------------------
# Provider-agnostic by design (section 20). The default is a free demo style;
# swap for your own tile provider in production.
MAP_TILE_PROVIDER=maplibre-demo
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
MAP_TILE_API_KEY=
GEOCODER_PROVIDER=none
GEOCODER_API_KEY=

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
MAX_IMAGE_PIXELS=50000000

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Feature flags (section 70) --------------------------------------------
# Experimental surfaces. Stable core features are always on and not listed.
FEATURE_CONSTELLATION=true
FEATURE_TEMPORAL_DEPTH=true
FEATURE_RIVER=false
FEATURE_STORY_DIRECTOR=false
FEATURE_WEBXR=false
FEATURE_RECONSTRUCTION=false
