{
  "name": "chronolignee",
  "version": "0.1.0",
  "private": true,
  "description": "Chronolignee — moteur genealogique temporel. Genealogie = graphe + temps + geographie + contexte historique + preuves.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.15.1",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @chronolignee/web dev",
    "dev:worker": "pnpm --filter @chronolignee/worker dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yaml,yml,css}\"",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @chronolignee/web exec playwright test",
    "test:coverage": "vitest run --project unit --coverage",
    "db:generate": "pnpm --filter @chronolignee/db generate",
    "db:migrate": "pnpm --filter @chronolignee/db migrate",
    "db:migrate:deploy": "pnpm --filter @chronolignee/db migrate:deploy",
    "db:drift": "pnpm --filter @chronolignee/db drift",
    "db:reset": "pnpm --filter @chronolignee/db reset",
    "db:seed": "pnpm --filter @chronolignee/db seed && pnpm --filter @chronolignee/worker seed:photos",
    "db:studio": "pnpm --filter @chronolignee/db studio",
    "benchmark": "pnpm --filter @chronolignee/engine benchmark",
    "benchmark:db": "pnpm --filter @chronolignee/db benchmark",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:nuke": "docker compose down -v",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit",
    "setup": "pnpm install && pnpm infra:up && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "test:e2e:ui": "pnpm --filter @chronolignee/web exec playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
