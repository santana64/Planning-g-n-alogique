// Chronolignee data model.
//
// Split across several files (Prisma multi-file schema) because a single
// schema.prisma for this domain would be unreadable. Each file covers one
// bounded area and says why its shape is what it is.
//
// Two conventions hold everywhere:
//
//  1. Every row that belongs to a genealogy carries `treeId`. It is the
//     tenancy boundary and the first column of nearly every index.
//  2. Ids are UUIDv7, generated by PostgreSQL 18 natively. They sort by
//     creation time, which keeps B-tree inserts local and makes
//     keyset pagination cheap — unlike UUIDv4.

generator client {
  provider        = "prisma-client"
  output          = "../../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, unaccent, citext, postgis]
}
