// Evidence: sources, citations and claims.
//
// This is the layer that separates Chronolignee from a contact database.
//
//   Source   — a thing that exists in an archive
//   Citation — the precise spot inside that source
//   Claim    — an assertion, attributed, dated, and citable
//
// A person's "birth date" is not a column. It is whichever birth-date Claim a
// human marked ACCEPTED. The rejected ones stay. A census that says 1878 and a
// baptism record that says 1877 disagree, and the disagreement is information
// worth keeping — it is often the thread that unpicks a wrong identification
// twenty years later.

enum SourceType {
  CIVIL_REGISTER
  PARISH_REGISTER
  CENSUS
  MILITARY_RECORD
  NOTARIAL_ACT
  NEWSPAPER
  CEMETERY
  BOOK
  WEBSITE
  DATABASE
  PHOTOGRAPH
  LETTER
  ORAL_HISTORY
  DNA
  OTHER
}

model Source {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  treeId String @db.Uuid

  title String
  type  SourceType @default(OTHER)

  author      String?
  publisher   String?
  publishedAt String?
  repository  String?
  /// Archival call number ("cote" in French archives). The single most useful
  /// field for anyone who has to find this document again.
  callNumber  String?
  url         String?
  accessedAt  DateTime?

  notes       String?
  /// How much weight this source carries in general, independent of any one
  /// citation from it.
  reliability Confidence @default(MEDIUM)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  citations Citation[]
  documents Document[]

  @@index([treeId, type])
  @@index([treeId, title])
  @@map("sources")
}

model Citation {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  treeId   String @db.Uuid
  sourceId String @db.Uuid

  /// Where inside the source: page, folio, view, act number.
  locator   String?
  page      String?
  volume    String?
  /// Verbatim transcription of the relevant passage.
  quotation String?

  confidence Confidence @default(MEDIUM)
  notes      String?

  documentId     String? @db.Uuid
  documentPageId String? @db.Uuid
  eventId        String? @db.Uuid

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid

  tree         Tree          @relation(fields: [treeId], references: [id], onDelete: Cascade)
  source       Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  document     Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentPage DocumentPage? @relation(fields: [documentPageId], references: [id], onDelete: SetNull)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)

  claims      ClaimCitation[]
  aiProposals AiProposal[]

  @@index([treeId, sourceId])
  @@index([documentId])
  @@map("citations")
}

/// What kind of assertion a Claim makes. The value shape is validated per
/// predicate by a Zod schema in @chronolignee/domain, not by the database:
/// Postgres cannot express "value is a GenealogicalDate when predicate is
/// BIRTH_DATE", and pretending otherwise with a dozen nullable columns would
/// be worse than one validated JSON column.
enum ClaimPredicate {
  NAME
  RECORDED_SEX
  BIRTH_DATE
  BIRTH_PLACE
  DEATH_DATE
  DEATH_PLACE
  BAPTISM_DATE
  BURIAL_DATE
  MARRIAGE_DATE
  MARRIAGE_PLACE
  OCCUPATION
  RESIDENCE
  PARENT
  SPOUSE
  CHILD
  MIGRATION
  MILITARY_SERVICE
  EDUCATION
  RELIGION
  NOTE
  OTHER
}

enum ClaimStatus {
  PROPOSED
  ACCEPTED
  DISPUTED
  REJECTED
  SUPERSEDED
}

model Claim {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  treeId String @db.Uuid

  // Exactly one subject is set. Enforced by a CHECK constraint added in the
  // migration, because Prisma has no way to express a polymorphic-but-typed
  // subject and separate nullable foreign keys keep referential integrity.
  personId       String? @db.Uuid
  relationshipId String? @db.Uuid
  eventId        String? @db.Uuid

  predicate ClaimPredicate
  /// Structured value. Shape depends on `predicate`; see domain/claim schemas.
  value     Json
  /// Flattened, human-readable rendering for lists, search and diffs.
  valueText String         @default("")

  status     ClaimStatus @default(PROPOSED)
  confidence Confidence  @default(MEDIUM)

  /// Set when a newer claim replaced this one. The old row is never deleted:
  /// the history of what we believed is itself research material.
  supersededById String? @db.Uuid

  /// Present when the claim originated from an AI extraction. Makes machine
  /// provenance auditable forever, not just until review.
  aiProposalId String? @db.Uuid

  createdById  String?   @db.Uuid
  reviewedById String?   @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tree         Tree          @relation(fields: [treeId], references: [id], onDelete: Cascade)
  person       Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)
  relationship Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  supersededBy Claim?  @relation("ClaimSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Claim[] @relation("ClaimSupersession")

  createdBy  User? @relation("ClaimCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("ClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  aiProposal AiProposal? @relation(fields: [aiProposalId], references: [id], onDelete: SetNull)

  citations ClaimCitation[]

  // The hot path: "give me the accepted birth-date claim for this person".
  @@index([treeId, personId, predicate, status])
  @@index([treeId, status])
  @@index([relationshipId])
  @@index([eventId])
  @@index([aiProposalId])
  @@map("claims")
}

/// Many-to-many: one citation can support several claims, and one claim can
/// rest on several citations. A claim with no citations is a hypothesis, and
/// the UI says so.
model ClaimCitation {
  claimId    String @db.Uuid
  citationId String @db.Uuid

  claim    Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  citation Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@id([claimId, citationId])
  @@index([citationId])
  @@map("claim_citations")
}
